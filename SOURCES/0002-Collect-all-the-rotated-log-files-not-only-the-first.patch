+def get_rotated_logs(logs, verbosity):
+    """Return the rotated files of the given logs, most recent rotations first.
+
+    The rotated files of a log are named `<log>.<n>` or `<log>.<n>.gz`. They are
+    sorted by rotation number, and the logs are interleaved in the order they
+    are given for each rotation number. On verbosity<9, only the rotations
+    with a number below the verbosity are returned, otherwise all of them."""
+
+    rotations = []
+    for index, log in enumerate(logs):
+        pattern = re.compile(re.escape(log) + r"\.([0-9]+)(\.gz)?$")
+        for path in glob.glob(glob.escape(log) + ".[0-9]*"):
+            match = pattern.match(path)
+            if match:
+                number = int(match.group(1))
+                if verbosity >= 9 or number < verbosity:
+                    rotations.append((number, index, path))
+    return [path for (_, _, path) in sorted(rotations)]
+
